FROM mcr.microsoft.com/azure-functions/python:4-python3.12

# Optional trusted, unauthenticated package mirror; public PyPI is the default.
ARG PIP_INDEX_URL=https://pypi.org/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AzureWebJobsScriptRoot=/home/site/wwwroot \
    PATH="/opt/python/3/bin:${PATH}"
WORKDIR /app

COPY pyproject.toml uv.lock README.md LICENSE ./
RUN python -m pip install --no-cache-dir uv==0.6.5 \
    && python -m uv export --locked --extra azure --no-dev --no-emit-project --format requirements-txt -o /tmp/requirements.txt \
    && python -m pip install --no-cache-dir -r /tmp/requirements.txt \
    && rm -f /tmp/requirements.txt

COPY src ./src
RUN python -m pip install --no-cache-dir --no-deps .
COPY functions/inference/ /home/site/wwwroot/

EXPOSE 80
